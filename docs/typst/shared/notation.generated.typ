  "rl.s_off": (tex: "s_t^{\\mathrm{off}}=(\\mathrm{VinSnippetView},\\mathcal{Q}_t,N_t,m_{t,i},\\ell_{t,i})", typst: "#eqs.rl.s_off", body: [#eqs.rl.s_off], description: "", thesis_list: false, order: 9999),
  "rl.s_oracle": (tex: "s_t^{\\mathrm{oracle}}=(s_t^{\\mathrm{cf+}},\\mathcal{M}^{\\mathrm{GT}},\\mathcal{M}_e^{\\mathrm{GT}},\\{D_{t,i}^{\\mathrm{GT}},\\mathcal{P}_{t,i}^{\\mathrm{GT}},\\mathrm{RRI}_{t,i}\\}_{i=1}^{N_t})", typst: "#eqs.rl.s_oracle", body: [#eqs.rl.s_oracle], description: "", thesis_list: false, order: 9999),
