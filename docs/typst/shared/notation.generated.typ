  (key: "scene.ray_memory_t", tex: "\\boldsymbol{M}_t^{\\mathrm{ray}}", typst: "#symb.scene.ray_memory_t", body: [#symb.scene.ray_memory_t], description: "Sparse actor-visible ray-aware memory separating occupied, free, and unknown support at step t.", thesis_list: true, order: 450),
  (key: "obs.dino_point_bank_t", tex: "\\boldsymbol{F}_t^{\\mathrm{DINO@pt}}", typst: "#symb.obs.dino_point_bank_t", body: [#symb.obs.dino_point_bank_t], description: "Visibility-gated logged DINO feature bank attached to semidense or fused world points.", thesis_list: true, order: 460),
  (key: "obs.point_tokens_t", tex: "\\boldsymbol{X}_t^{\\mathrm{pt}}", typst: "#symb.obs.point_tokens_t", body: [#symb.obs.point_tokens_t], description: "Point-token set combining geometry, support, uncertainty, history, and optional compressed logged descriptors.", thesis_list: true, order: 470),
  (key: "scene.scene_memory_t", tex: "\\boldsymbol{\\Phi}_t^{\\mathrm{scene}}", typst: "#symb.scene.scene_memory_t", body: [#symb.scene.scene_memory_t], description: "Composite actor-visible scene-memory descriptor queried by the finite-candidate value model.", thesis_list: true, order: 480),
  (key: "scene.evl_local", tex: "\\boldsymbol{E}_0^{\\mathrm{EVL-local}}", typst: "#symb.scene.evl_local", body: [#symb.scene.evl_local], description: "Root local EVL evidence field used for target/candidate support reads.", thesis_list: true, order: 490),
  (key: "scene.evl_support_frac", tex: "\\omega_{t,i}^{\\mathrm{EVL}}", typst: "#symb.scene.evl_support_frac", body: [#symb.scene.evl_support_frac], description: "Candidate or target-query fraction supported by the root EVL voxel extent.", thesis_list: true, order: 500),
  (key: "scene.evl_support_token", tex: "\\boldsymbol{g}_{t,i}^{\\mathrm{EVL}}", typst: "#symb.scene.evl_support_token", body: [#symb.scene.evl_support_token], description: "Pooled local EVL evidence token for a target, candidate frustum, or target-candidate intersection query.", thesis_list: true, order: 510),
  (key: "scene.target_support_pool", tex: "\\boldsymbol{g}_e^{\\mathrm{tgt}}", typst: "#symb.scene.target_support_pool", body: [#symb.scene.target_support_pool], description: "Pooled target-support descriptor for the selected target hypothesis.", thesis_list: true, order: 520),
  (key: "scene.frustum_support_pool", tex: "\\boldsymbol{g}_{t,i}^{\\mathrm{fr}}", typst: "#symb.scene.frustum_support_pool", body: [#symb.scene.frustum_support_pool], description: "Candidate-frustum support descriptor pooled from actor-visible scene memory.", thesis_list: true, order: 530),
  (key: "scene.target_frustum_pool", tex: "\\boldsymbol{g}_{t,e,i}^{\\cap}", typst: "#symb.scene.target_frustum_pool", body: [#symb.scene.target_frustum_pool], description: "Pooled descriptor over the intersection between target support and candidate frustum support.", thesis_list: true, order: 540),
  (key: "scene.ray_query_ti", tex: "\\boldsymbol{g}_{t,i}^{\\mathrm{ray}}", typst: "#symb.scene.ray_query_ti", body: [#symb.scene.ray_query_ti], description: "Candidate-conditioned ray query over occupied, free, unknown, hit, target-support, and uncertainty summaries.", thesis_list: true, order: 550),
  (key: "scene.render_query", tex: "\\operatorname{RenderQuery}", typst: "#symb.scene.render_query", body: [#symb.scene.render_query], description: "Abstract query operator that summarizes scene memory in a candidate camera/frustum without introducing fresh counterfactual RGB features.", thesis_list: true, order: 560),
  (key: "spatial.ref_pose", tex: "r_t", typst: "#symb.spatial.ref_pose", body: [#symb.spatial.ref_pose], description: "Reference pose for candidate-relative descriptor construction at decision step t.", thesis_list: true, order: 565),
  (key: "spatial.ref_candidate_transform", tex: "\\boldsymbol{T}_{r_t,i}^{\\mathrm{rel}}", typst: "#symb.spatial.ref_candidate_transform", body: [#symb.spatial.ref_candidate_transform], description: "Relative transform from the reference pose r_t to candidate camera i.", thesis_list: true, order: 568),
  (key: "spatial.candidate_pose_feat", tex: "\\boldsymbol{h}_{t,i}^{\\mathrm{pose}}", typst: "#symb.spatial.candidate_pose_feat", body: [#symb.spatial.candidate_pose_feat], description: "Relative/local candidate pose descriptor derived from a reference pose rather than raw world coordinates.", thesis_list: true, order: 570),
  (key: "spatial.candidate_target_rel_feat", tex: "\\boldsymbol{h}_{t,e\\mid i}^{\\mathrm{rel}}", typst: "#symb.spatial.candidate_target_rel_feat", body: [#symb.spatial.candidate_target_rel_feat], description: "Candidate-target relation descriptor in the candidate/query local frame.", thesis_list: true, order: 580),
  (key: "spatial.relation_rpe", tex: "\\boldsymbol{e}_{a\\mid i}^{\\mathrm{rel}}", typst: "#symb.spatial.relation_rpe", body: [#symb.spatial.relation_rpe], description: "Query-local relative positional embedding for target, history, support, or candidate relations.", thesis_list: true, order: 590),
  (key: "model.target_token", tex: "\\boldsymbol{h}_e^{\\mathrm{tgt}}", typst: "#symb.model.target_token", body: [#symb.model.target_token], description: "Learned selected-target token built from the actor-visible target descriptor and scene support.", thesis_list: true, order: 600),
  (key: "model.candidate_row", tex: "\\boldsymbol{x}_{t,i}", typst: "#symb.model.candidate_row", body: [#symb.model.candidate_row], description: "Per-candidate row feature assembled from pose, relation, support, validity, provenance, and history descriptors.", thesis_list: true, order: 610),
  (key: "oracle.reference_geometry", tex: "\\mathcal{M}", typst: "#symb.oracle.reference_geometry", body: [#symb.oracle.reference_geometry], description: "Generic reference geometry used by reconstruction-quality metrics.", thesis_list: true, order: 620),
  (key: "oracle.reference_samples", tex: "\\mathcal{S}", typst: "#symb.oracle.reference_samples", body: [#symb.oracle.reference_samples], description: "Declared sample set drawn from the generic reference geometry for completeness and recall.", thesis_list: true, order: 630),
  (key: "oracle.tolerance", tex: "\\tau", typst: "#symb.oracle.tolerance", body: [#symb.oracle.tolerance], description: "Declared distance tolerance for thresholded reconstruction diagnostics.", thesis_list: true, order: 640),
)

#let notation-equations = (
  "action.candidate_shell": (tex: "\\mathcal{Q}_t=\\{q_{t,i}\\}_{i=1}^{N_q},\\quad N_q=60", typst: "#eqs.action.candidate_shell", body: [#eqs.action.candidate_shell], description: "", thesis_list: false, order: 9999),
  "action.robust_temperature_softmax": (tex: "\\ell_i=(s_i-\\operatorname{median}(s))/(\\operatorname{IQR}(s)\\tau),\\quad P(i\\mid m_i=1)=\\exp(\\ell_i)/\\sum_{j:m_j=1}\\exp(\\ell_j)", typst: "#eqs.action.robust_temperature_softmax", body: [#eqs.action.robust_temperature_softmax], description: "", thesis_list: false, order: 9999),
  "action.space": (tex: "\\mathcal{A}^{\\mathrm{cont}}\\subset\\mathbb{R}^3\\times \\operatorname{SO}(2)", typst: "#eqs.action.space", body: [#eqs.action.space], description: "", thesis_list: false, order: 9999),
  "binning.edges": (tex: "e_k=\\operatorname{Quantile}(\\{r_i\\}_{i=1}^{N}, k/K),\\quad k\\in\\{1,\\ldots,K-1\\}", typst: "#eqs.binning.edges", body: [#eqs.binning.edges], description: "", thesis_list: false, order: 9999),
  "binning.label": (tex: "y(r)=\\sum_{k=1}^{K-1}\\mathbb{1}[r>e_k],\\quad y(r)\\in\\{0,\\ldots,K-1\\}", typst: "#eqs.binning.label", body: [#eqs.binning.label], description: "", thesis_list: false, order: 9999),
  "binning.levels": (tex: "t_k=\\mathbb{1}[y>k],\\quad k\\in\\{0,\\ldots,K-2\\}", typst: "#eqs.binning.levels", body: [#eqs.binning.levels], description: "", thesis_list: false, order: 9999),
  "coral.loss": (tex: "\\mathcal{L}_{\\mathrm{coral}}(y,\\boldsymbol{p})=-\\sum_{k=0}^{K-2}\\left(t_k\\log p_k+(1-t_k)\\log(1-p_k)\\right)", typst: "#eqs.coral.loss", body: [#eqs.coral.loss], description: "", thesis_list: false, order: 9999),
  "coral.rel_random": (tex: "\\mathcal{L}_{\\mathrm{rel}}=\\mathcal{L}_{\\mathrm{coral}}/((K-1)\\log 2)", typst: "#eqs.coral.rel_random", body: [#eqs.coral.rel_random], description: "", thesis_list: false, order: 9999),
  "entity.objective": (tex: "\\mathrm{RRI}_{\\mathrm{total}}(q)=\\sum_{e\\in\\mathcal{E}}w_e\\mathrm{RRI}_e+\\lambda_{\\mathrm{scene}}\\mathrm{RRI}", typst: "#eqs.entity.objective", body: [#eqs.entity.objective], description: "", thesis_list: false, order: 9999),
  "entity.target_descriptor": (tex: "\\boldsymbol{\\phi}_e=\\operatorname{Enc}_{\\mathrm{tgt}}(\\hat{\\boldsymbol{B}}_e,\\hat{\\boldsymbol{y}}_e,\\hat{\\pi}_e,A_e^{\\mathrm{proj}},n_e^{\\mathrm{semi}},n_e^{\\mathrm{EVL}},\\omega_e^{\\mathrm{EVL}},\\ell_e^{\\mathrm{src}},\\boldsymbol{T}_{r_t,e},\\boldsymbol{T}_{c_t,e})", typst: "#eqs.entity.target_descriptor", body: [#eqs.entity.target_descriptor], description: "", thesis_list: false, order: 9999),
  "features.point_dino_token": (tex: "\\boldsymbol{x}_j^{\\mathrm{pt}}=\\operatorname{concat}(\\boldsymbol{p}_j,\\boldsymbol{f}_j^{\\mathrm{DINO-comp}},\\sigma_j^{-1},n_j,\\boldsymbol{a}_j^{\\mathrm{hist}})", typst: "#eqs.features.point_dino_token", body: [#eqs.features.point_dino_token], description: "", thesis_list: false, order: 9999),
  "metrics.candidate_validity": (tex: "m_i=\\mathbb{1}[\\mathrm{finite}]\\mathbb{1}[v_i>0]\\mathbb{1}[v_i^{\\mathrm{sem}}>0]", typst: "#eqs.metrics.candidate_validity", body: [#eqs.metrics.candidate_validity], description: "", thesis_list: false, order: 9999),
  "metrics.closest_point_witness": (tex: "\\boldsymbol{w}(\\boldsymbol{p})=\\operatorname*{argmin}_{\\boldsymbol{x}\\in\\mathcal{M}}\\lVert\\boldsymbol{p}-\\boldsymbol{x}\\rVert_2", typst: "#eqs.metrics.closest_point_witness", body: [#eqs.metrics.closest_point_witness], description: "Closest-point witness attaining the query-to-reference-geometry distance.", thesis_list: false, order: 9999),
  "metrics.directed_reconstruction_errors": (tex: "d_{\\mathrm{acc}}(\\mathcal{P}\\to\\mathcal{M})=\\frac{1}{|\\mathcal{P}|}\\sum_{\\boldsymbol{p}\\in\\mathcal{P}}d(\\boldsymbol{p},\\mathcal{M}),\\quad d_{\\mathrm{comp}}(\\mathcal{M}\\to\\mathcal{P})=\\frac{1}{|\\mathcal{S}|}\\sum_{\\boldsymbol{s}\\in\\mathcal{S}}d(\\boldsymbol{s},\\mathcal{P})", typst: "#eqs.metrics.directed_reconstruction_errors", body: [#eqs.metrics.directed_reconstruction_errors], description: "Unsquared directed accuracy and completeness errors.", thesis_list: false, order: 9999),
  "metrics.point_to_reference_distance": (tex: "d(\\boldsymbol{x},\\mathcal{M})=\\min_{\\boldsymbol{y}\\in\\mathcal{M}}\\lVert\\boldsymbol{x}-\\boldsymbol{y}\\rVert_2", typst: "#eqs.metrics.point_to_reference_distance", body: [#eqs.metrics.point_to_reference_distance], description: "Unsquared Euclidean distance from a query point to the reference geometry.", thesis_list: false, order: 9999),
  "metrics.spearman": (tex: "\\rho=\\operatorname{corr}(\\operatorname{rank}(\\hat{r}_i),\\operatorname{rank}(r_i))", typst: "#eqs.metrics.spearman", body: [#eqs.metrics.spearman], description: "", thesis_list: false, order: 9999),
  "metrics.threshold_reconstruction_diagnostics": (tex: "\\mathrm{precision}_{\\tau}=\\frac{1}{|\\mathcal{P}|}\\sum_{\\boldsymbol{p}\\in\\mathcal{P}}\\mathbb{1}[d(\\boldsymbol{p},\\mathcal{M})<\\tau],\\quad \\mathrm{recall}_{\\tau}=\\frac{1}{|\\mathcal{S}|}\\sum_{\\boldsymbol{s}\\in\\mathcal{S}}\\mathbb{1}[d(\\boldsymbol{s},\\mathcal{P})<\\tau],\\quad F_{\\tau}=\\frac{2\\,\\mathrm{precision}_{\\tau}\\,\\mathrm{recall}_{\\tau}}{\\mathrm{precision}_{\\tau}+\\mathrm{recall}_{\\tau}}", typst: "#eqs.metrics.threshold_reconstruction_diagnostics", body: [#eqs.metrics.threshold_reconstruction_diagnostics], description: "Threshold precision, recall, and their harmonic-mean F-score.", thesis_list: false, order: 9999),
  "metrics.topk_acc": (tex: "\\mathrm{TopKAcc}(k)=\\frac{1}{N}\\sum_i\\mathbb{1}[y_i\\in\\mathrm{TopK}(\\boldsymbol{\\pi}_i,k)]", typst: "#eqs.metrics.topk_acc", body: [#eqs.metrics.topk_acc], description: "", thesis_list: false, order: 9999),
  "model.candidate_row_features": (tex: "\\boldsymbol{x}_{t,i}=\\operatorname{concat}(\\boldsymbol{h}_{t,i}^{\\mathrm{pose+rel}},\\boldsymbol{h}_{t,i}^{\\mathrm{geom}},\\boldsymbol{h}_{t,i}^{\\mathrm{valid}},\\boldsymbol{h}_{t,i}^{\\mathrm{prov}},\\boldsymbol{H}_t)", typst: "#eqs.model.candidate_row_features", body: [#eqs.model.candidate_row_features], description: "", thesis_list: false, order: 9999),
  "model.qh_target_token": (tex: "\\boldsymbol{h}_e^{\\mathrm{tgt}}=\\operatorname{MLP}_{\\mathrm{tgt}}(\\operatorname{concat}(\\boldsymbol{\\phi}_e,\\boldsymbol{g}_e^{\\mathrm{tgt}}))", typst: "#eqs.model.qh_target_token", body: [#eqs.model.qh_target_token], description: "", thesis_list: false, order: 9999),
  "rl.candidate_row_equivariance": (tex: "f_\\theta(\\Pi X_t,\\Pi m_t)=\\Pi f_\\theta(X_t,m_t)", typst: "#eqs.rl.candidate_row_equivariance", body: [#eqs.rl.candidate_row_equivariance], description: "", thesis_list: false, order: 9999),
  "rl.counterfactual_transition": (tex: "\\mathcal{P}_{t+1}=\\mathcal{P}_t\\cup\\mathcal{P}_{q_t}", typst: "#eqs.rl.counterfactual_transition", body: [#eqs.rl.counterfactual_transition], description: "", thesis_list: false, order: 9999),
  "rl.evidence_chain": (tex: "\\mathcal{U}_{\\mathrm{cov/unc}}\\to\\hat r_t^e(i)\\to r_t^e\\to G_t^{(H)}\\to Q_{H,\\theta}", typst: "#eqs.rl.evidence_chain", body: [#eqs.rl.evidence_chain], description: "", thesis_list: false, order: 9999),
  "rl.finite_action_set": (tex: "\\mathcal{Q}_t=\\{q_{t,i}\\}_{i=1}^{N_t},\\quad \\mathcal{A}(s_t)=\\{i\\in\\{1,\\ldots,N_t\\}:m_{t,i}=1\\},\\quad q_t=q_{t,a_t}", typst: "#eqs.rl.finite_action_set", body: [#eqs.rl.finite_action_set], description: "", thesis_list: false, order: 9999),
  "rl.finite_horizon_return": (tex: "G_t^{(H)}=\\sum_{k=0}^{H-1}\\gamma^k r_{t+k}^e", typst: "#eqs.rl.finite_horizon_return", body: [#eqs.rl.finite_horizon_return], description: "", thesis_list: false, order: 9999),
  "rl.masked_candidate_selection": (tex: "\\mathcal{A}_t=\\{i:m_{t,i}=1\\},\\quad a_t^\\theta=\\operatorname*{argmax}_{i\\in\\mathcal{A}_t} f_{\\theta,i}(X_t,m_t)", typst: "#eqs.rl.masked_candidate_selection", body: [#eqs.rl.masked_candidate_selection], description: "", thesis_list: false, order: 9999),
  "rl.mdp": (tex: "\\mathcal{M}=(\\mathcal{S},\\mathcal{A},P,r,\\gamma)", typst: "#eqs.rl.mdp", body: [#eqs.rl.mdp], description: "", thesis_list: false, order: 9999),
  "rl.nbv_mdp": (tex: "\\mathcal{M}_{\\mathrm{NBV}}=(\\mathcal{S},\\mathcal{A},T,r_e,\\gamma,H)", typst: "#eqs.rl.nbv_mdp", body: [#eqs.rl.nbv_mdp], description: "", thesis_list: false, order: 9999),
  "rl.nbv_process_tuple": (tex: "\\mathcal{M}_{\\mathrm{NBV}}=(\\mathcal{S}^{\\mathrm{hist}},\\mathcal{S}^{\\mathrm{cf0}},\\mathcal{S}^{\\mathrm{oracle}},\\{\\mathcal{A}_t\\},T,r_t^e,\\gamma,H)", typst: "#eqs.rl.nbv_process_tuple", body: [#eqs.rl.nbv_process_tuple], description: "", thesis_list: false, order: 9999),
  "rl.q_backup": (tex: "y_t^Q=r_t+\\gamma V(s_{t+1})", typst: "#eqs.rl.q_backup", body: [#eqs.rl.q_backup], description: "", thesis_list: false, order: 9999),
  "rl.q_h": (tex: "Q_H(s_t^{\\mathrm{cf0}},a_t)=\\mathbb{E}\\left[G_t^{(H)}\\mid s_t=s_t^{\\mathrm{cf0}},a_t\\right]", typst: "#eqs.rl.q_h", body: [#eqs.rl.q_h], description: "", thesis_list: false, order: 9999),
  "rl.qh_behavior_return": (tex: "G_{t,e}^{(h),\\mu}=\\sum_{k=0}^{h-1}\\gamma^k r_{t+k}^e", typst: "#eqs.rl.qh_behavior_return", body: [#eqs.rl.qh_behavior_return], description: "", thesis_list: false, order: 9999),
  "rl.qh_doubleq_selector": (tex: "j^*=\\operatorname*{argmax}_{j:m_{t+1,j}=1}Q_\\theta(s_{t+1},e,j,h-1)", typst: "#eqs.rl.qh_doubleq_selector", body: [#eqs.rl.qh_doubleq_selector], description: "", thesis_list: false, order: 9999),
  "rl.qh_exact_two_step_target": (tex: "y_t^{(2,e),\\mathrm{exact}}=r_t^e+\\gamma\\max_{j:m_{t+1,j}^{\\mathrm{train}}=1}r_{t+1,j}^e", typst: "#eqs.rl.qh_exact_two_step_target", body: [#eqs.rl.qh_exact_two_step_target], description: "", thesis_list: false, order: 9999),
  "rl.qh_horizon_query_token": (tex: "u_{t,e,h,i}=\\operatorname{CrossAttn}_\\theta(x_{t,e,i}+\\operatorname{Emb}_h(h),\\{h_e^{\\mathrm{tgt}},\\Phi_t^{\\mathrm{scene}},\\boldsymbol{H}_t,b_t\\})", typst: "#eqs.rl.qh_horizon_query_token", body: [#eqs.rl.qh_horizon_query_token], description: "", thesis_list: false, order: 9999),
  "rl.qh_one_step_target": (tex: "y_t^{(1,e)}=r_t^e", typst: "#eqs.rl.qh_one_step_target", body: [#eqs.rl.qh_one_step_target], description: "", thesis_list: false, order: 9999),
  "rl.qh_query": (tex: "Q_\\theta(s_t,e,i,h)=Q_{h,e}^\\theta(s_t,i),\\ 1\\le h\\le b_t\\le H", typst: "#eqs.rl.qh_query", body: [#eqs.rl.qh_query], description: "", thesis_list: false, order: 9999),
  "rl.qh_recursive_target": (tex: "y_t^{(h,e)}=\\begin{cases}r_t^e,&h=1\\ \\mathrm{or}\\ d_t=1\\\\r_t^e+\\gamma\\max_{j:m_{t+1,j}=1}Q_{\\bar\\theta}(s_{t+1},e,j,h-1),&h>1\\ \\mathrm{and}\\ d_t=0\\end{cases}", typst: "#eqs.rl.qh_recursive_target", body: [#eqs.rl.qh_recursive_target], description: "", thesis_list: false, order: 9999),
  "rl.qh_residual_decomposition": (tex: "Q_{H,\\theta,i}=b_{\\psi,i}+\\delta_{\\theta,i}^{H}", typst: "#eqs.rl.qh_residual_decomposition", body: [#eqs.rl.qh_residual_decomposition], description: "", thesis_list: false, order: 9999),
  "rl.reward_geom": (tex: "r_t^{\\mathrm{geom}}=\\log(D(\\mathcal{P}_t,\\mathcal{M}^{\\mathrm{GT}})+\\varepsilon)-\\log(D(\\mathcal{P}_{t+1},\\mathcal{M}^{\\mathrm{GT}})+\\varepsilon)-\\alpha\\mathbb{1}[\\mathrm{collision}(a_t)]-\\beta c(a_t)", typst: "#eqs.rl.reward_geom", body: [#eqs.rl.reward_geom], description: "", thesis_list: false, order: 9999),
  "rl.s_actor": (tex: "s_t^{\\mathrm{actor}}=(s_t^{\\mathrm{cf0}},\\boldsymbol{H}_t)", typst: "#eqs.rl.s_actor", body: [#eqs.rl.s_actor], description: "", thesis_list: false, order: 9999),
  "rl.s_cf0": (tex: "s_t^{\\mathrm{cf0}}=(V^{\\mathrm{root}},\\mathcal{P}_t,\\mathcal{Q}_t,m_{t,i},\\rho_{t,i},e_t,b_t)", typst: "#eqs.rl.s_cf0", body: [#eqs.rl.s_cf0], description: "", thesis_list: false, order: 9999),
  "rl.s_cf_geom": (tex: "s_t^{\\mathrm{cf+}}=(s_t^{\\mathrm{cf0}},D_{1:t}^{\\mathrm{sel}},P_{1:t}^{\\mathrm{sel}},N_{1:t}^{\\mathrm{sel}})", typst: "#eqs.rl.s_cf_geom", body: [#eqs.rl.s_cf_geom], description: "", thesis_list: false, order: 9999),
  "rl.s_hist": (tex: "s_t^{\\mathrm{hist}}=(I_{1:t},T_{1:t},P_{1:t}^{\\mathrm{semi}},V^{\\mathrm{root}},e_t,b_t)", typst: "#eqs.rl.s_hist", body: [#eqs.rl.s_hist], description: "", thesis_list: false, order: 9999),
  "rl.s_off": (tex: "s_t^{\\mathrm{off}}=(\\mathrm{VinSnippetView},\\mathcal{Q}_t,N_t,m_{t,i},\\ell_{t,i})", typst: "#eqs.rl.s_off", body: [#eqs.rl.s_off], description: "", thesis_list: false, order: 9999),
  "rl.s_oracle": (tex: "s_t^{\\mathrm{oracle}}=(s_t^{\\mathrm{cf+}},\\mathcal{M}^{\\mathrm{GT}},\\mathcal{M}_e^{\\mathrm{GT}},\\{D_{t,i}^{\\mathrm{GT}},\\mathcal{P}_{t,i}^{\\mathrm{GT}},\\mathrm{RRI}_{t,i}\\}_{i=1}^{N_t})", typst: "#eqs.rl.s_oracle", body: [#eqs.rl.s_oracle], description: "", thesis_list: false, order: 9999),
  "rl.selected_observation": (tex: "o_{t+1}^{\\mathrm{sel}}=(D_{t,a_t},V_{t,a_t},K_{t,a_t},T_{\\mathrm{root}\\leftarrow\\mathrm{cam},t,a_t},\\ell_{t,a_t}^{\\mathrm{src}})", typst: "#eqs.rl.selected_observation", body: [#eqs.rl.selected_observation], description: "", thesis_list: false, order: 9999),
  "rl.target_conditioned_state": (tex: "s_t^e=(\\Phi_t^{\\mathrm{scene}},z_e,\\boldsymbol{H}_t,b_t),\\quad Q_h(s_t^e,i)\\equiv Q_{h,e}(s_t,i)", typst: "#eqs.rl.target_conditioned_state", body: [#eqs.rl.target_conditioned_state], description: "", thesis_list: false, order: 9999),
  "rl.target_rri_reward": (tex: "r_t^e=\\mathrm{RRI}_e(q_t\\mid \\mathcal{P}_t,\\mathcal{M}_e^{\\mathrm{GT}})", typst: "#eqs.rl.target_rri_reward", body: [#eqs.rl.target_rri_reward], description: "", thesis_list: false, order: 9999),
  "rri.acc": (tex: "D_{P\\to M}(\\mathcal{P},\\mathcal{M}^{\\mathrm{GT}})=\\frac{1}{\\lVert\\mathcal{P}\\rVert}\\sum_{\\boldsymbol{p}\\in\\mathcal{P}}\\min_{\\boldsymbol{f}\\in\\mathcal{F}^{\\mathrm{GT}}} d(\\boldsymbol{p},\\boldsymbol{f})^2", typst: "#eqs.rri.acc", body: [#eqs.rri.acc], description: "", thesis_list: false, order: 9999),
  "rri.cd": (tex: "D(\\mathcal{P},\\mathcal{M}^{\\mathrm{GT}})=D_{P\\to M}(\\mathcal{P},\\mathcal{M}^{\\mathrm{GT}})+D_{M\\to P}(\\mathcal{P},\\mathcal{M}^{\\mathrm{GT}})", typst: "#eqs.rri.cd", body: [#eqs.rri.cd], description: "", thesis_list: false, order: 9999),
  "rri.comp": (tex: "D_{M\\to P}(\\mathcal{P},\\mathcal{M}^{\\mathrm{GT}})=\\frac{1}{\\lVert\\mathcal{F}^{\\mathrm{GT}}\\rVert}\\sum_{\\boldsymbol{f}\\in\\mathcal{F}^{\\mathrm{GT}}}\\min_{\\boldsymbol{p}\\in\\mathcal{P}} d(\\boldsymbol{p},\\boldsymbol{f})^2", typst: "#eqs.rri.comp", body: [#eqs.rri.comp], description: "", thesis_list: false, order: 9999),
  "rri.greedy": (tex: "q^*=\\operatorname*{argmax}_{q\\in\\mathcal{Q}}\\mathrm{RRI}(q)", typst: "#eqs.rri.greedy", body: [#eqs.rri.greedy], description: "", thesis_list: false, order: 9999),
  "rri.rri": (tex: "\\mathrm{RRI}(q)=\\frac{D(\\mathcal{P}_t,\\mathcal{M}^{\\mathrm{GT}})-D(\\mathcal{P}_t\\cup\\mathcal{P}_q,\\mathcal{M}^{\\mathrm{GT}})}{D(\\mathcal{P}_t,\\mathcal{M}^{\\mathrm{GT}})+\\varepsilon}", typst: "#eqs.rri.rri", body: [#eqs.rri.rri], description: "", thesis_list: false, order: 9999),
  "rri.target_rri": (tex: "\\mathrm{RRI}_e(q)=\\frac{D(\\mathcal{P}_t^e,\\mathcal{M}_e^{\\mathrm{GT}})-D(\\mathcal{P}_t^e\\cup\\mathcal{P}_q^e,\\mathcal{M}_e^{\\mathrm{GT}})}{D(\\mathcal{P}_t^e,\\mathcal{M}_e^{\\mathrm{GT}})+\\varepsilon}", typst: "#eqs.rri.target_rri", body: [#eqs.rri.target_rri], description: "", thesis_list: false, order: 9999),
  "rri.union": (tex: "\\mathcal{P}_{t\\cup q}=\\mathcal{P}_t\\cup\\mathcal{P}_q", typst: "#eqs.rri.union", body: [#eqs.rri.union], description: "", thesis_list: false, order: 9999),
  "scene.candidate_query_pools": (tex: "\\boldsymbol{g}_e^{\\mathrm{tgt}},\\boldsymbol{g}_{t,i}^{\\mathrm{fr}},\\boldsymbol{g}_{t,e,i}^{\\cap}=\\operatorname{Pool}(\\boldsymbol{x}_j^{\\mathrm{pt}})", typst: "#eqs.scene.candidate_query_pools", body: [#eqs.scene.candidate_query_pools], description: "", thesis_list: false, order: 9999),
  "scene.candidate_ray_query": (tex: "\\boldsymbol{g}_{t,i}^{\\mathrm{ray}}=\\operatorname{RenderQuery}(\\boldsymbol{M}_t^{\\mathrm{ray}},q_{t,i},\\hat{\\boldsymbol{B}}_e)", typst: "#eqs.scene.candidate_ray_query", body: [#eqs.scene.candidate_ray_query], description: "", thesis_list: false, order: 9999),
  "scene.evl_local_support_read": (tex: "\\omega_{t,i}^{\\mathrm{EVL}}=\\frac{1}{K}\\sum_{k=1}^{K}\\mathbb{1}[x_{t,i,k}\\in\\mathcal{V}_0^{\\mathrm{EVL}}]", typst: "#eqs.scene.evl_local_support_read", body: [#eqs.scene.evl_local_support_read], description: "", thesis_list: false, order: 9999),
  "scene.qh_scene_memory": (tex: "\\boldsymbol{\\Phi}_t^{\\mathrm{scene}}=(\\boldsymbol{M}_t^{\\mathrm{ray}},\\boldsymbol{X}_t^{\\mathrm{pt}},\\boldsymbol{F}_t^{\\mathrm{DINO@pt}},\\boldsymbol{E}_0^{\\mathrm{EVL-local}},\\boldsymbol{O}_t^{\\mathrm{pred}},\\boldsymbol{M}^{\\mathrm{dir}})", typst: "#eqs.scene.qh_scene_memory", body: [#eqs.scene.qh_scene_memory], description: "", thesis_list: false, order: 9999),
  "scene.ray_memory_update": (tex: "\\boldsymbol{M}_{t+1}^{\\mathrm{ray}}=\\operatorname{Fuse}(\\boldsymbol{M}_t^{\\mathrm{ray}},\\mathcal{P}_{t,i}^{\\mathrm{cand}},\\mathcal{R}_{t,i}^{\\mathrm{sel}})", typst: "#eqs.scene.ray_memory_update", body: [#eqs.scene.ray_memory_update], description: "", thesis_list: false, order: 9999),
  "scene.scene_memory_decomposition": (tex: "\\Phi_t^{\\mathrm{scene}}=(\\Phi_0^{\\mathrm{static}},M_t^{\\mathrm{dynamic}})", typst: "#eqs.scene.scene_memory_decomposition", body: [#eqs.scene.scene_memory_decomposition], description: "", thesis_list: false, order: 9999),
  "spatial.candidate_pose_features": (tex: "\\boldsymbol{h}_{t,i}^{\\mathrm{pose}}=\\operatorname{concat}(\\boldsymbol{\\delta}_{r_t,i}^{p},\\operatorname{R6D}(\\boldsymbol{R}_{r_t,i}),\\|\\boldsymbol{\\delta}_{r_t,i}^{p}\\|_2,\\operatorname{atan2}(\\delta_{r_t,i}^{y},\\delta_{r_t,i}^{x}),\\Delta h_{t,i},\\boldsymbol{u}_{t,i}^{\\mathrm{up/frustum}})", typst: "#eqs.spatial.candidate_pose_features", body: [#eqs.spatial.candidate_pose_features], description: "", thesis_list: false, order: 9999),
  "spatial.candidate_query_local_frame": (tex: "\\boldsymbol{\\delta}_{a\\mid i}^{p}=\\boldsymbol{R}_{t,i}^{\\top}(\\boldsymbol{p}_a-\\boldsymbol{c}_{t,i})", typst: "#eqs.spatial.candidate_query_local_frame", body: [#eqs.spatial.candidate_query_local_frame], description: "", thesis_list: false, order: 9999),
  "spatial.candidate_query_rpe": (tex: "\\boldsymbol{e}_{a\\mid i}^{\\mathrm{rel}}=\\psi_{\\mathrm{rel}}(\\mathcal{F}(\\boldsymbol{\\eta}_{a\\mid i}))", typst: "#eqs.spatial.candidate_query_rpe", body: [#eqs.spatial.candidate_query_rpe], description: "", thesis_list: false, order: 9999),
  "spatial.candidate_reference_transform": (tex: "\\boldsymbol{T}_{r_t,i}^{\\mathrm{rel}}=\\boldsymbol{T}_{w,r_t}^{-1}\\boldsymbol{T}_{w,c_{t,i}},\\quad \\boldsymbol{\\delta}_{r_t,i}^{p}=\\boldsymbol{R}_{r_t}^{\\top}(\\boldsymbol{c}_{t,i}-\\boldsymbol{c}_{r_t}),\\quad \\boldsymbol{R}_{r_t,i}=\\boldsymbol{R}_{r_t}^{\\top}\\boldsymbol{R}_{t,i}", typst: "#eqs.spatial.candidate_reference_transform", body: [#eqs.spatial.candidate_reference_transform], description: "", thesis_list: false, order: 9999),
  "spatial.candidate_target_relation": (tex: "\\boldsymbol{h}_{t,e\\mid i}^{\\mathrm{rel}}=\\operatorname{concat}(\\boldsymbol{\\delta}_{e\\mid i}^{p},\\|\\boldsymbol{\\delta}_{e\\mid i}^{p}\\|_2,\\cos\\theta_{t,e,i}^{\\mathrm{opt}},\\beta_{t,e,i}^{\\mathrm{elev}},\\lambda_{t,e,i}^{\\mathrm{obb}})", typst: "#eqs.spatial.candidate_target_relation", body: [#eqs.spatial.candidate_target_relation], description: "", thesis_list: false, order: 9999),
  "spatial.direction_memory_moment": (tex: "\\boldsymbol{M}^{\\mathrm{dir}}(\\boldsymbol{v})=\\sum_{k<t}w_k(\\boldsymbol{v})\\boldsymbol{d}_k(\\boldsymbol{v})\\boldsymbol{d}_k(\\boldsymbol{v})^\\top", typst: "#eqs.spatial.direction_memory_moment", body: [#eqs.spatial.direction_memory_moment], description: "", thesis_list: false, order: 9999),
  "spatial.direction_memory_sh": (tex: "\\boldsymbol{h}^{\\mathrm{dir}}(\\boldsymbol{v})=\\sum_{k<t}w_k(\\boldsymbol{v})\\boldsymbol{Y}_L(\\boldsymbol{d}_k(\\boldsymbol{v}))", typst: "#eqs.spatial.direction_memory_sh", body: [#eqs.spatial.direction_memory_sh], description: "", thesis_list: false, order: 9999),
  "spatial.direction_novelty": (tex: "\\nu_{t,i}^{\\mathrm{dir}}(\\boldsymbol{v})=1-\\frac{\\boldsymbol{d}_{t,i}(\\boldsymbol{v})^\\top\\boldsymbol{M}^{\\mathrm{dir}}(\\boldsymbol{v})\\boldsymbol{d}_{t,i}(\\boldsymbol{v})}{\\operatorname{tr}(\\boldsymbol{M}^{\\mathrm{dir}}(\\boldsymbol{v}))+\\varepsilon}", typst: "#eqs.spatial.direction_novelty", body: [#eqs.spatial.direction_novelty], description: "", thesis_list: false, order: 9999),
  "spatial.direction_unit": (tex: "\\boldsymbol{d}_k(\\boldsymbol{v})=(\\boldsymbol{c}_k-\\boldsymbol{v})/\\|\\boldsymbol{c}_k-\\boldsymbol{v}\\|_2", typst: "#eqs.spatial.direction_unit", body: [#eqs.spatial.direction_unit], description: "", thesis_list: false, order: 9999),
  "vin.aux_reg_mse": (tex: "\\mathcal{L}_{\\mathrm{reg}}=\\frac{1}{N}\\sum_i(\\hat{r}_i-r_i)^2", typst: "#eqs.vin.aux_reg_mse", body: [#eqs.vin.aux_reg_mse], description: "", thesis_list: false, order: 9999),
  "vin.loss_total": (tex: "\\mathcal{L}=\\mathcal{L}_{\\mathrm{coral}}+\\lambda\\mathcal{L}_{\\mathrm{reg}}", typst: "#eqs.vin.loss_total", body: [#eqs.vin.loss_total], description: "", thesis_list: false, order: 9999),
)

#let notation-equations-list = (
  (key: "action.candidate_shell", tex: "\\mathcal{Q}_t=\\{q_{t,i}\\}_{i=1}^{N_q},\\quad N_q=60", typst: "#eqs.action.candidate_shell", body: [#eqs.action.candidate_shell], description: "", thesis_list: false, order: 9999),
  (key: "action.robust_temperature_softmax", tex: "\\ell_i=(s_i-\\operatorname{median}(s))/(\\operatorname{IQR}(s)\\tau),\\quad P(i\\mid m_i=1)=\\exp(\\ell_i)/\\sum_{j:m_j=1}\\exp(\\ell_j)", typst: "#eqs.action.robust_temperature_softmax", body: [#eqs.action.robust_temperature_softmax], description: "", thesis_list: false, order: 9999),
  (key: "action.space", tex: "\\mathcal{A}^{\\mathrm{cont}}\\subset\\mathbb{R}^3\\times \\operatorname{SO}(2)", typst: "#eqs.action.space", body: [#eqs.action.space], description: "", thesis_list: false, order: 9999),
  (key: "binning.edges", tex: "e_k=\\operatorname{Quantile}(\\{r_i\\}_{i=1}^{N}, k/K),\\quad k\\in\\{1,\\ldots,K-1\\}", typst: "#eqs.binning.edges", body: [#eqs.binning.edges], description: "", thesis_list: false, order: 9999),
  (key: "binning.label", tex: "y(r)=\\sum_{k=1}^{K-1}\\mathbb{1}[r>e_k],\\quad y(r)\\in\\{0,\\ldots,K-1\\}", typst: "#eqs.binning.label", body: [#eqs.binning.label], description: "", thesis_list: false, order: 9999),
  (key: "binning.levels", tex: "t_k=\\mathbb{1}[y>k],\\quad k\\in\\{0,\\ldots,K-2\\}", typst: "#eqs.binning.levels", body: [#eqs.binning.levels], description: "", thesis_list: false, order: 9999),
  (key: "coral.loss", tex: "\\mathcal{L}_{\\mathrm{coral}}(y,\\boldsymbol{p})=-\\sum_{k=0}^{K-2}\\left(t_k\\log p_k+(1-t_k)\\log(1-p_k)\\right)", typst: "#eqs.coral.loss", body: [#eqs.coral.loss], description: "", thesis_list: false, order: 9999),
  (key: "coral.rel_random", tex: "\\mathcal{L}_{\\mathrm{rel}}=\\mathcal{L}_{\\mathrm{coral}}/((K-1)\\log 2)", typst: "#eqs.coral.rel_random", body: [#eqs.coral.rel_random], description: "", thesis_list: false, order: 9999),
  (key: "entity.objective", tex: "\\mathrm{RRI}_{\\mathrm{total}}(q)=\\sum_{e\\in\\mathcal{E}}w_e\\mathrm{RRI}_e+\\lambda_{\\mathrm{scene}}\\mathrm{RRI}", typst: "#eqs.entity.objective", body: [#eqs.entity.objective], description: "", thesis_list: false, order: 9999),
  (key: "entity.target_descriptor", tex: "\\boldsymbol{\\phi}_e=\\operatorname{Enc}_{\\mathrm{tgt}}(\\hat{\\boldsymbol{B}}_e,\\hat{\\boldsymbol{y}}_e,\\hat{\\pi}_e,A_e^{\\mathrm{proj}},n_e^{\\mathrm{semi}},n_e^{\\mathrm{EVL}},\\omega_e^{\\mathrm{EVL}},\\ell_e^{\\mathrm{src}},\\boldsymbol{T}_{r_t,e},\\boldsymbol{T}_{c_t,e})", typst: "#eqs.entity.target_descriptor", body: [#eqs.entity.target_descriptor], description: "", thesis_list: false, order: 9999),
  (key: "features.point_dino_token", tex: "\\boldsymbol{x}_j^{\\mathrm{pt}}=\\operatorname{concat}(\\boldsymbol{p}_j,\\boldsymbol{f}_j^{\\mathrm{DINO-comp}},\\sigma_j^{-1},n_j,\\boldsymbol{a}_j^{\\mathrm{hist}})", typst: "#eqs.features.point_dino_token", body: [#eqs.features.point_dino_token], description: "", thesis_list: false, order: 9999),
  (key: "metrics.candidate_validity", tex: "m_i=\\mathbb{1}[\\mathrm{finite}]\\mathbb{1}[v_i>0]\\mathbb{1}[v_i^{\\mathrm{sem}}>0]", typst: "#eqs.metrics.candidate_validity", body: [#eqs.metrics.candidate_validity], description: "", thesis_list: false, order: 9999),
  (key: "metrics.closest_point_witness", tex: "\\boldsymbol{w}(\\boldsymbol{p})=\\operatorname*{argmin}_{\\boldsymbol{x}\\in\\mathcal{M}}\\lVert\\boldsymbol{p}-\\boldsymbol{x}\\rVert_2", typst: "#eqs.metrics.closest_point_witness", body: [#eqs.metrics.closest_point_witness], description: "Closest-point witness attaining the query-to-reference-geometry distance.", thesis_list: false, order: 9999),
  (key: "metrics.directed_reconstruction_errors", tex: "d_{\\mathrm{acc}}(\\mathcal{P}\\to\\mathcal{M})=\\frac{1}{|\\mathcal{P}|}\\sum_{\\boldsymbol{p}\\in\\mathcal{P}}d(\\boldsymbol{p},\\mathcal{M}),\\quad d_{\\mathrm{comp}}(\\mathcal{M}\\to\\mathcal{P})=\\frac{1}{|\\mathcal{S}|}\\sum_{\\boldsymbol{s}\\in\\mathcal{S}}d(\\boldsymbol{s},\\mathcal{P})", typst: "#eqs.metrics.directed_reconstruction_errors", body: [#eqs.metrics.directed_reconstruction_errors], description: "Unsquared directed accuracy and completeness errors.", thesis_list: false, order: 9999),
  (key: "metrics.point_to_reference_distance", tex: "d(\\boldsymbol{x},\\mathcal{M})=\\min_{\\boldsymbol{y}\\in\\mathcal{M}}\\lVert\\boldsymbol{x}-\\boldsymbol{y}\\rVert_2", typst: "#eqs.metrics.point_to_reference_distance", body: [#eqs.metrics.point_to_reference_distance], description: "Unsquared Euclidean distance from a query point to the reference geometry.", thesis_list: false, order: 9999),
  (key: "metrics.spearman", tex: "\\rho=\\operatorname{corr}(\\operatorname{rank}(\\hat{r}_i),\\operatorname{rank}(r_i))", typst: "#eqs.metrics.spearman", body: [#eqs.metrics.spearman], description: "", thesis_list: false, order: 9999),
  (key: "metrics.threshold_reconstruction_diagnostics", tex: "\\mathrm{precision}_{\\tau}=\\frac{1}{|\\mathcal{P}|}\\sum_{\\boldsymbol{p}\\in\\mathcal{P}}\\mathbb{1}[d(\\boldsymbol{p},\\mathcal{M})<\\tau],\\quad \\mathrm{recall}_{\\tau}=\\frac{1}{|\\mathcal{S}|}\\sum_{\\boldsymbol{s}\\in\\mathcal{S}}\\mathbb{1}[d(\\boldsymbol{s},\\mathcal{P})<\\tau],\\quad F_{\\tau}=\\frac{2\\,\\mathrm{precision}_{\\tau}\\,\\mathrm{recall}_{\\tau}}{\\mathrm{precision}_{\\tau}+\\mathrm{recall}_{\\tau}}", typst: "#eqs.metrics.threshold_reconstruction_diagnostics", body: [#eqs.metrics.threshold_reconstruction_diagnostics], description: "Threshold precision, recall, and their harmonic-mean F-score.", thesis_list: false, order: 9999),
  (key: "metrics.topk_acc", tex: "\\mathrm{TopKAcc}(k)=\\frac{1}{N}\\sum_i\\mathbb{1}[y_i\\in\\mathrm{TopK}(\\boldsymbol{\\pi}_i,k)]", typst: "#eqs.metrics.topk_acc", body: [#eqs.metrics.topk_acc], description: "", thesis_list: false, order: 9999),
  (key: "model.candidate_row_features", tex: "\\boldsymbol{x}_{t,i}=\\operatorname{concat}(\\boldsymbol{h}_{t,i}^{\\mathrm{pose+rel}},\\boldsymbol{h}_{t,i}^{\\mathrm{geom}},\\boldsymbol{h}_{t,i}^{\\mathrm{valid}},\\boldsymbol{h}_{t,i}^{\\mathrm{prov}},\\boldsymbol{H}_t)", typst: "#eqs.model.candidate_row_features", body: [#eqs.model.candidate_row_features], description: "", thesis_list: false, order: 9999),
  (key: "model.qh_target_token", tex: "\\boldsymbol{h}_e^{\\mathrm{tgt}}=\\operatorname{MLP}_{\\mathrm{tgt}}(\\operatorname{concat}(\\boldsymbol{\\phi}_e,\\boldsymbol{g}_e^{\\mathrm{tgt}}))", typst: "#eqs.model.qh_target_token", body: [#eqs.model.qh_target_token], description: "", thesis_list: false, order: 9999),
  (key: "rl.candidate_row_equivariance", tex: "f_\\theta(\\Pi X_t,\\Pi m_t)=\\Pi f_\\theta(X_t,m_t)", typst: "#eqs.rl.candidate_row_equivariance", body: [#eqs.rl.candidate_row_equivariance], description: "", thesis_list: false, order: 9999),
  (key: "rl.counterfactual_transition", tex: "\\mathcal{P}_{t+1}=\\mathcal{P}_t\\cup\\mathcal{P}_{q_t}", typst: "#eqs.rl.counterfactual_transition", body: [#eqs.rl.counterfactual_transition], description: "", thesis_list: false, order: 9999),
  (key: "rl.evidence_chain", tex: "\\mathcal{U}_{\\mathrm{cov/unc}}\\to\\hat r_t^e(i)\\to r_t^e\\to G_t^{(H)}\\to Q_{H,\\theta}", typst: "#eqs.rl.evidence_chain", body: [#eqs.rl.evidence_chain], description: "", thesis_list: false, order: 9999),
  (key: "rl.finite_action_set", tex: "\\mathcal{Q}_t=\\{q_{t,i}\\}_{i=1}^{N_t},\\quad \\mathcal{A}(s_t)=\\{i\\in\\{1,\\ldots,N_t\\}:m_{t,i}=1\\},\\quad q_t=q_{t,a_t}", typst: "#eqs.rl.finite_action_set", body: [#eqs.rl.finite_action_set], description: "", thesis_list: false, order: 9999),
  (key: "rl.finite_horizon_return", tex: "G_t^{(H)}=\\sum_{k=0}^{H-1}\\gamma^k r_{t+k}^e", typst: "#eqs.rl.finite_horizon_return", body: [#eqs.rl.finite_horizon_return], description: "", thesis_list: false, order: 9999),
  (key: "rl.masked_candidate_selection", tex: "\\mathcal{A}_t=\\{i:m_{t,i}=1\\},\\quad a_t^\\theta=\\operatorname*{argmax}_{i\\in\\mathcal{A}_t} f_{\\theta,i}(X_t,m_t)", typst: "#eqs.rl.masked_candidate_selection", body: [#eqs.rl.masked_candidate_selection], description: "", thesis_list: false, order: 9999),
  (key: "rl.mdp", tex: "\\mathcal{M}=(\\mathcal{S},\\mathcal{A},P,r,\\gamma)", typst: "#eqs.rl.mdp", body: [#eqs.rl.mdp], description: "", thesis_list: false, order: 9999),
  (key: "rl.nbv_mdp", tex: "\\mathcal{M}_{\\mathrm{NBV}}=(\\mathcal{S},\\mathcal{A},T,r_e,\\gamma,H)", typst: "#eqs.rl.nbv_mdp", body: [#eqs.rl.nbv_mdp], description: "", thesis_list: false, order: 9999),
  (key: "rl.nbv_process_tuple", tex: "\\mathcal{M}_{\\mathrm{NBV}}=(\\mathcal{S}^{\\mathrm{hist}},\\mathcal{S}^{\\mathrm{cf0}},\\mathcal{S}^{\\mathrm{oracle}},\\{\\mathcal{A}_t\\},T,r_t^e,\\gamma,H)", typst: "#eqs.rl.nbv_process_tuple", body: [#eqs.rl.nbv_process_tuple], description: "", thesis_list: false, order: 9999),
  (key: "rl.q_backup", tex: "y_t^Q=r_t+\\gamma V(s_{t+1})", typst: "#eqs.rl.q_backup", body: [#eqs.rl.q_backup], description: "", thesis_list: false, order: 9999),
  (key: "rl.q_h", tex: "Q_H(s_t^{\\mathrm{cf0}},a_t)=\\mathbb{E}\\left[G_t^{(H)}\\mid s_t=s_t^{\\mathrm{cf0}},a_t\\right]", typst: "#eqs.rl.q_h", body: [#eqs.rl.q_h], description: "", thesis_list: false, order: 9999),
  (key: "rl.qh_behavior_return", tex: "G_{t,e}^{(h),\\mu}=\\sum_{k=0}^{h-1}\\gamma^k r_{t+k}^e", typst: "#eqs.rl.qh_behavior_return", body: [#eqs.rl.qh_behavior_return], description: "", thesis_list: false, order: 9999),
  (key: "rl.qh_doubleq_selector", tex: "j^*=\\operatorname*{argmax}_{j:m_{t+1,j}=1}Q_\\theta(s_{t+1},e,j,h-1)", typst: "#eqs.rl.qh_doubleq_selector", body: [#eqs.rl.qh_doubleq_selector], description: "", thesis_list: false, order: 9999),
  (key: "rl.qh_exact_two_step_target", tex: "y_t^{(2,e),\\mathrm{exact}}=r_t^e+\\gamma\\max_{j:m_{t+1,j}^{\\mathrm{train}}=1}r_{t+1,j}^e", typst: "#eqs.rl.qh_exact_two_step_target", body: [#eqs.rl.qh_exact_two_step_target], description: "", thesis_list: false, order: 9999),
  (key: "rl.qh_horizon_query_token", tex: "u_{t,e,h,i}=\\operatorname{CrossAttn}_\\theta(x_{t,e,i}+\\operatorname{Emb}_h(h),\\{h_e^{\\mathrm{tgt}},\\Phi_t^{\\mathrm{scene}},\\boldsymbol{H}_t,b_t\\})", typst: "#eqs.rl.qh_horizon_query_token", body: [#eqs.rl.qh_horizon_query_token], description: "", thesis_list: false, order: 9999),
  (key: "rl.qh_one_step_target", tex: "y_t^{(1,e)}=r_t^e", typst: "#eqs.rl.qh_one_step_target", body: [#eqs.rl.qh_one_step_target], description: "", thesis_list: false, order: 9999),
  (key: "rl.qh_query", tex: "Q_\\theta(s_t,e,i,h)=Q_{h,e}^\\theta(s_t,i),\\ 1\\le h\\le b_t\\le H", typst: "#eqs.rl.qh_query", body: [#eqs.rl.qh_query], description: "", thesis_list: false, order: 9999),
  (key: "rl.qh_recursive_target", tex: "y_t^{(h,e)}=\\begin{cases}r_t^e,&h=1\\ \\mathrm{or}\\ d_t=1\\\\r_t^e+\\gamma\\max_{j:m_{t+1,j}=1}Q_{\\bar\\theta}(s_{t+1},e,j,h-1),&h>1\\ \\mathrm{and}\\ d_t=0\\end{cases}", typst: "#eqs.rl.qh_recursive_target", body: [#eqs.rl.qh_recursive_target], description: "", thesis_list: false, order: 9999),
  (key: "rl.qh_residual_decomposition", tex: "Q_{H,\\theta,i}=b_{\\psi,i}+\\delta_{\\theta,i}^{H}", typst: "#eqs.rl.qh_residual_decomposition", body: [#eqs.rl.qh_residual_decomposition], description: "", thesis_list: false, order: 9999),
  (key: "rl.reward_geom", tex: "r_t^{\\mathrm{geom}}=\\log(D(\\mathcal{P}_t,\\mathcal{M}^{\\mathrm{GT}})+\\varepsilon)-\\log(D(\\mathcal{P}_{t+1},\\mathcal{M}^{\\mathrm{GT}})+\\varepsilon)-\\alpha\\mathbb{1}[\\mathrm{collision}(a_t)]-\\beta c(a_t)", typst: "#eqs.rl.reward_geom", body: [#eqs.rl.reward_geom], description: "", thesis_list: false, order: 9999),
  (key: "rl.s_actor", tex: "s_t^{\\mathrm{actor}}=(s_t^{\\mathrm{cf0}},\\boldsymbol{H}_t)", typst: "#eqs.rl.s_actor", body: [#eqs.rl.s_actor], description: "", thesis_list: false, order: 9999),
  (key: "rl.s_cf0", tex: "s_t^{\\mathrm{cf0}}=(V^{\\mathrm{root}},\\mathcal{P}_t,\\mathcal{Q}_t,m_{t,i},\\rho_{t,i},e_t,b_t)", typst: "#eqs.rl.s_cf0", body: [#eqs.rl.s_cf0], description: "", thesis_list: false, order: 9999),
  (key: "rl.s_cf_geom", tex: "s_t^{\\mathrm{cf+}}=(s_t^{\\mathrm{cf0}},D_{1:t}^{\\mathrm{sel}},P_{1:t}^{\\mathrm{sel}},N_{1:t}^{\\mathrm{sel}})", typst: "#eqs.rl.s_cf_geom", body: [#eqs.rl.s_cf_geom], description: "", thesis_list: false, order: 9999),
  (key: "rl.s_hist", tex: "s_t^{\\mathrm{hist}}=(I_{1:t},T_{1:t},P_{1:t}^{\\mathrm{semi}},V^{\\mathrm{root}},e_t,b_t)", typst: "#eqs.rl.s_hist", body: [#eqs.rl.s_hist], description: "", thesis_list: false, order: 9999),
  (key: "rl.s_off", tex: "s_t^{\\mathrm{off}}=(\\mathrm{VinSnippetView},\\mathcal{Q}_t,N_t,m_{t,i},\\ell_{t,i})", typst: "#eqs.rl.s_off", body: [#eqs.rl.s_off], description: "", thesis_list: false, order: 9999),
  (key: "rl.s_oracle", tex: "s_t^{\\mathrm{oracle}}=(s_t^{\\mathrm{cf+}},\\mathcal{M}^{\\mathrm{GT}},\\mathcal{M}_e^{\\mathrm{GT}},\\{D_{t,i}^{\\mathrm{GT}},\\mathcal{P}_{t,i}^{\\mathrm{GT}},\\mathrm{RRI}_{t,i}\\}_{i=1}^{N_t})", typst: "#eqs.rl.s_oracle", body: [#eqs.rl.s_oracle], description: "", thesis_list: false, order: 9999),
  (key: "rl.selected_observation", tex: "o_{t+1}^{\\mathrm{sel}}=(D_{t,a_t},V_{t,a_t},K_{t,a_t},T_{\\mathrm{root}\\leftarrow\\mathrm{cam},t,a_t},\\ell_{t,a_t}^{\\mathrm{src}})", typst: "#eqs.rl.selected_observation", body: [#eqs.rl.selected_observation], description: "", thesis_list: false, order: 9999),
  (key: "rl.target_conditioned_state", tex: "s_t^e=(\\Phi_t^{\\mathrm{scene}},z_e,\\boldsymbol{H}_t,b_t),\\quad Q_h(s_t^e,i)\\equiv Q_{h,e}(s_t,i)", typst: "#eqs.rl.target_conditioned_state", body: [#eqs.rl.target_conditioned_state], description: "", thesis_list: false, order: 9999),
  (key: "rl.target_rri_reward", tex: "r_t^e=\\mathrm{RRI}_e(q_t\\mid \\mathcal{P}_t,\\mathcal{M}_e^{\\mathrm{GT}})", typst: "#eqs.rl.target_rri_reward", body: [#eqs.rl.target_rri_reward], description: "", thesis_list: false, order: 9999),
  (key: "rri.acc", tex: "D_{P\\to M}(\\mathcal{P},\\mathcal{M}^{\\mathrm{GT}})=\\frac{1}{\\lVert\\mathcal{P}\\rVert}\\sum_{\\boldsymbol{p}\\in\\mathcal{P}}\\min_{\\boldsymbol{f}\\in\\mathcal{F}^{\\mathrm{GT}}} d(\\boldsymbol{p},\\boldsymbol{f})^2", typst: "#eqs.rri.acc", body: [#eqs.rri.acc], description: "", thesis_list: false, order: 9999),
  (key: "rri.cd", tex: "D(\\mathcal{P},\\mathcal{M}^{\\mathrm{GT}})=D_{P\\to M}(\\mathcal{P},\\mathcal{M}^{\\mathrm{GT}})+D_{M\\to P}(\\mathcal{P},\\mathcal{M}^{\\mathrm{GT}})", typst: "#eqs.rri.cd", body: [#eqs.rri.cd], description: "", thesis_list: false, order: 9999),
  (key: "rri.comp", tex: "D_{M\\to P}(\\mathcal{P},\\mathcal{M}^{\\mathrm{GT}})=\\frac{1}{\\lVert\\mathcal{F}^{\\mathrm{GT}}\\rVert}\\sum_{\\boldsymbol{f}\\in\\mathcal{F}^{\\mathrm{GT}}}\\min_{\\boldsymbol{p}\\in\\mathcal{P}} d(\\boldsymbol{p},\\boldsymbol{f})^2", typst: "#eqs.rri.comp", body: [#eqs.rri.comp], description: "", thesis_list: false, order: 9999),
  (key: "rri.greedy", tex: "q^*=\\operatorname*{argmax}_{q\\in\\mathcal{Q}}\\mathrm{RRI}(q)", typst: "#eqs.rri.greedy", body: [#eqs.rri.greedy], description: "", thesis_list: false, order: 9999),
  (key: "rri.rri", tex: "\\mathrm{RRI}(q)=\\frac{D(\\mathcal{P}_t,\\mathcal{M}^{\\mathrm{GT}})-D(\\mathcal{P}_t\\cup\\mathcal{P}_q,\\mathcal{M}^{\\mathrm{GT}})}{D(\\mathcal{P}_t,\\mathcal{M}^{\\mathrm{GT}})+\\varepsilon}", typst: "#eqs.rri.rri", body: [#eqs.rri.rri], description: "", thesis_list: false, order: 9999),
  (key: "rri.target_rri", tex: "\\mathrm{RRI}_e(q)=\\frac{D(\\mathcal{P}_t^e,\\mathcal{M}_e^{\\mathrm{GT}})-D(\\mathcal{P}_t^e\\cup\\mathcal{P}_q^e,\\mathcal{M}_e^{\\mathrm{GT}})}{D(\\mathcal{P}_t^e,\\mathcal{M}_e^{\\mathrm{GT}})+\\varepsilon}", typst: "#eqs.rri.target_rri", body: [#eqs.rri.target_rri], description: "", thesis_list: false, order: 9999),
  (key: "rri.union", tex: "\\mathcal{P}_{t\\cup q}=\\mathcal{P}_t\\cup\\mathcal{P}_q", typst: "#eqs.rri.union", body: [#eqs.rri.union], description: "", thesis_list: false, order: 9999),
  (key: "scene.candidate_query_pools", tex: "\\boldsymbol{g}_e^{\\mathrm{tgt}},\\boldsymbol{g}_{t,i}^{\\mathrm{fr}},\\boldsymbol{g}_{t,e,i}^{\\cap}=\\operatorname{Pool}(\\boldsymbol{x}_j^{\\mathrm{pt}})", typst: "#eqs.scene.candidate_query_pools", body: [#eqs.scene.candidate_query_pools], description: "", thesis_list: false, order: 9999),
  (key: "scene.candidate_ray_query", tex: "\\boldsymbol{g}_{t,i}^{\\mathrm{ray}}=\\operatorname{RenderQuery}(\\boldsymbol{M}_t^{\\mathrm{ray}},q_{t,i},\\hat{\\boldsymbol{B}}_e)", typst: "#eqs.scene.candidate_ray_query", body: [#eqs.scene.candidate_ray_query], description: "", thesis_list: false, order: 9999),
  (key: "scene.evl_local_support_read", tex: "\\omega_{t,i}^{\\mathrm{EVL}}=\\frac{1}{K}\\sum_{k=1}^{K}\\mathbb{1}[x_{t,i,k}\\in\\mathcal{V}_0^{\\mathrm{EVL}}]", typst: "#eqs.scene.evl_local_support_read", body: [#eqs.scene.evl_local_support_read], description: "", thesis_list: false, order: 9999),
  (key: "scene.qh_scene_memory", tex: "\\boldsymbol{\\Phi}_t^{\\mathrm{scene}}=(\\boldsymbol{M}_t^{\\mathrm{ray}},\\boldsymbol{X}_t^{\\mathrm{pt}},\\boldsymbol{F}_t^{\\mathrm{DINO@pt}},\\boldsymbol{E}_0^{\\mathrm{EVL-local}},\\boldsymbol{O}_t^{\\mathrm{pred}},\\boldsymbol{M}^{\\mathrm{dir}})", typst: "#eqs.scene.qh_scene_memory", body: [#eqs.scene.qh_scene_memory], description: "", thesis_list: false, order: 9999),
  (key: "scene.ray_memory_update", tex: "\\boldsymbol{M}_{t+1}^{\\mathrm{ray}}=\\operatorname{Fuse}(\\boldsymbol{M}_t^{\\mathrm{ray}},\\mathcal{P}_{t,i}^{\\mathrm{cand}},\\mathcal{R}_{t,i}^{\\mathrm{sel}})", typst: "#eqs.scene.ray_memory_update", body: [#eqs.scene.ray_memory_update], description: "", thesis_list: false, order: 9999),
  (key: "scene.scene_memory_decomposition", tex: "\\Phi_t^{\\mathrm{scene}}=(\\Phi_0^{\\mathrm{static}},M_t^{\\mathrm{dynamic}})", typst: "#eqs.scene.scene_memory_decomposition", body: [#eqs.scene.scene_memory_decomposition], description: "", thesis_list: false, order: 9999),
  (key: "spatial.candidate_pose_features", tex: "\\boldsymbol{h}_{t,i}^{\\mathrm{pose}}=\\operatorname{concat}(\\boldsymbol{\\delta}_{r_t,i}^{p},\\operatorname{R6D}(\\boldsymbol{R}_{r_t,i}),\\|\\boldsymbol{\\delta}_{r_t,i}^{p}\\|_2,\\operatorname{atan2}(\\delta_{r_t,i}^{y},\\delta_{r_t,i}^{x}),\\Delta h_{t,i},\\boldsymbol{u}_{t,i}^{\\mathrm{up/frustum}})", typst: "#eqs.spatial.candidate_pose_features", body: [#eqs.spatial.candidate_pose_features], description: "", thesis_list: false, order: 9999),
  (key: "spatial.candidate_query_local_frame", tex: "\\boldsymbol{\\delta}_{a\\mid i}^{p}=\\boldsymbol{R}_{t,i}^{\\top}(\\boldsymbol{p}_a-\\boldsymbol{c}_{t,i})", typst: "#eqs.spatial.candidate_query_local_frame", body: [#eqs.spatial.candidate_query_local_frame], description: "", thesis_list: false, order: 9999),
  (key: "spatial.candidate_query_rpe", tex: "\\boldsymbol{e}_{a\\mid i}^{\\mathrm{rel}}=\\psi_{\\mathrm{rel}}(\\mathcal{F}(\\boldsymbol{\\eta}_{a\\mid i}))", typst: "#eqs.spatial.candidate_query_rpe", body: [#eqs.spatial.candidate_query_rpe], description: "", thesis_list: false, order: 9999),
  (key: "spatial.candidate_reference_transform", tex: "\\boldsymbol{T}_{r_t,i}^{\\mathrm{rel}}=\\boldsymbol{T}_{w,r_t}^{-1}\\boldsymbol{T}_{w,c_{t,i}},\\quad \\boldsymbol{\\delta}_{r_t,i}^{p}=\\boldsymbol{R}_{r_t}^{\\top}(\\boldsymbol{c}_{t,i}-\\boldsymbol{c}_{r_t}),\\quad \\boldsymbol{R}_{r_t,i}=\\boldsymbol{R}_{r_t}^{\\top}\\boldsymbol{R}_{t,i}", typst: "#eqs.spatial.candidate_reference_transform", body: [#eqs.spatial.candidate_reference_transform], description: "", thesis_list: false, order: 9999),
  (key: "spatial.candidate_target_relation", tex: "\\boldsymbol{h}_{t,e\\mid i}^{\\mathrm{rel}}=\\operatorname{concat}(\\boldsymbol{\\delta}_{e\\mid i}^{p},\\|\\boldsymbol{\\delta}_{e\\mid i}^{p}\\|_2,\\cos\\theta_{t,e,i}^{\\mathrm{opt}},\\beta_{t,e,i}^{\\mathrm{elev}},\\lambda_{t,e,i}^{\\mathrm{obb}})", typst: "#eqs.spatial.candidate_target_relation", body: [#eqs.spatial.candidate_target_relation], description: "", thesis_list: false, order: 9999),
  (key: "spatial.direction_memory_moment", tex: "\\boldsymbol{M}^{\\mathrm{dir}}(\\boldsymbol{v})=\\sum_{k<t}w_k(\\boldsymbol{v})\\boldsymbol{d}_k(\\boldsymbol{v})\\boldsymbol{d}_k(\\boldsymbol{v})^\\top", typst: "#eqs.spatial.direction_memory_moment", body: [#eqs.spatial.direction_memory_moment], description: "", thesis_list: false, order: 9999),
  (key: "spatial.direction_memory_sh", tex: "\\boldsymbol{h}^{\\mathrm{dir}}(\\boldsymbol{v})=\\sum_{k<t}w_k(\\boldsymbol{v})\\boldsymbol{Y}_L(\\boldsymbol{d}_k(\\boldsymbol{v}))", typst: "#eqs.spatial.direction_memory_sh", body: [#eqs.spatial.direction_memory_sh], description: "", thesis_list: false, order: 9999),
  (key: "spatial.direction_novelty", tex: "\\nu_{t,i}^{\\mathrm{dir}}(\\boldsymbol{v})=1-\\frac{\\boldsymbol{d}_{t,i}(\\boldsymbol{v})^\\top\\boldsymbol{M}^{\\mathrm{dir}}(\\boldsymbol{v})\\boldsymbol{d}_{t,i}(\\boldsymbol{v})}{\\operatorname{tr}(\\boldsymbol{M}^{\\mathrm{dir}}(\\boldsymbol{v}))+\\varepsilon}", typst: "#eqs.spatial.direction_novelty", body: [#eqs.spatial.direction_novelty], description: "", thesis_list: false, order: 9999),
  (key: "spatial.direction_unit", tex: "\\boldsymbol{d}_k(\\boldsymbol{v})=(\\boldsymbol{c}_k-\\boldsymbol{v})/\\|\\boldsymbol{c}_k-\\boldsymbol{v}\\|_2", typst: "#eqs.spatial.direction_unit", body: [#eqs.spatial.direction_unit], description: "", thesis_list: false, order: 9999),
  (key: "vin.aux_reg_mse", tex: "\\mathcal{L}_{\\mathrm{reg}}=\\frac{1}{N}\\sum_i(\\hat{r}_i-r_i)^2", typst: "#eqs.vin.aux_reg_mse", body: [#eqs.vin.aux_reg_mse], description: "", thesis_list: false, order: 9999),
  (key: "vin.loss_total", tex: "\\mathcal{L}=\\mathcal{L}_{\\mathrm{coral}}+\\lambda\\mathcal{L}_{\\mathrm{reg}}", typst: "#eqs.vin.loss_total", body: [#eqs.vin.loss_total], description: "", thesis_list: false, order: 9999),
)
