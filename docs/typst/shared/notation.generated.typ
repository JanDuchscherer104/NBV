  "rri.acc": (tex: "D_{P\\to M}(\\mathcal{P},\\mathcal{M}^{\\mathrm{GT}})=\\frac{1}{\\lVert\\mathcal{P}\\rVert}\\sum_{\\boldsymbol{p}\\in\\mathcal{P}}\\min_{\\boldsymbol{f}\\in\\mathcal{F}^{\\mathrm{GT}}} d(\\boldsymbol{p},\\boldsymbol{f})^2", typst: "#eqs.rri.acc", body: [#eqs.rri.acc], description: "", thesis_list: false, order: 9999),
  "rri.cd": (tex: "D(\\mathcal{P},\\mathcal{M}^{\\mathrm{GT}})=D_{P\\to M}(\\mathcal{P},\\mathcal{M}^{\\mathrm{GT}})+D_{M\\to P}(\\mathcal{P},\\mathcal{M}^{\\mathrm{GT}})", typst: "#eqs.rri.cd", body: [#eqs.rri.cd], description: "", thesis_list: false, order: 9999),
  "rri.comp": (tex: "D_{M\\to P}(\\mathcal{P},\\mathcal{M}^{\\mathrm{GT}})=\\frac{1}{\\lVert\\mathcal{F}^{\\mathrm{GT}}\\rVert}\\sum_{\\boldsymbol{f}\\in\\mathcal{F}^{\\mathrm{GT}}}\\min_{\\boldsymbol{p}\\in\\mathcal{P}} d(\\boldsymbol{p},\\boldsymbol{f})^2", typst: "#eqs.rri.comp", body: [#eqs.rri.comp], description: "", thesis_list: false, order: 9999),
  "rri.greedy": (tex: "q^*=\\operatorname*{argmax}_{q\\in\\mathcal{Q}}\\mathrm{RRI}(q)", typst: "#eqs.rri.greedy", body: [#eqs.rri.greedy], description: "", thesis_list: false, order: 9999),
  "rri.rri": (tex: "\\mathrm{RRI}(q)=\\frac{D(\\mathcal{P}_t,\\mathcal{M}^{\\mathrm{GT}})-D(\\mathcal{P}_t\\cup\\mathcal{P}_q,\\mathcal{M}^{\\mathrm{GT}})}{D(\\mathcal{P}_t,\\mathcal{M}^{\\mathrm{GT}})+\\varepsilon}", typst: "#eqs.rri.rri", body: [#eqs.rri.rri], description: "", thesis_list: false, order: 9999),
  "rri.target_rri": (tex: "\\mathrm{RRI}_e(q)=\\frac{D(\\mathcal{P}_t^e,\\mathcal{M}_e^{\\mathrm{GT}})-D(\\mathcal{P}_t^e\\cup\\mathcal{P}_q^e,\\mathcal{M}_e^{\\mathrm{GT}})}{D(\\mathcal{P}_t^e,\\mathcal{M}_e^{\\mathrm{GT}})+\\varepsilon}", typst: "#eqs.rri.target_rri", body: [#eqs.rri.target_rri], description: "", thesis_list: false, order: 9999),
  "rri.union": (tex: "\\mathcal{P}_{t\\cup q}=\\mathcal{P}_t\\cup\\mathcal{P}_q", typst: "#eqs.rri.union", body: [#eqs.rri.union], description: "", thesis_list: false, order: 9999),
  "vin.aux_reg_mse": (tex: "\\mathcal{L}_{\\mathrm{reg}}=\\frac{1}{N}\\sum_i(\\hat{r}_i-r_i)^2", typst: "#eqs.vin.aux_reg_mse", body: [#eqs.vin.aux_reg_mse], description: "", thesis_list: false, order: 9999),
