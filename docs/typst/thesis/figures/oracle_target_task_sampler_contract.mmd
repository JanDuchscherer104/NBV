---
config:
  theme: base
  htmlLabels: true
  flowchart:
    htmlLabels: true
    nodeSpacing: 28
    rankSpacing: 40
    curve: basis
  layout: elk
  themeVariables:
    background: "#ffffff"
    fontFamily: "Inter, DejaVu Sans, Arial, sans-serif"
    fontSize: "20px"
    primaryTextColor: "#17202a"
    lineColor: "#64748b"
  themeCSS: |
    .nodeLabel { font-size: 20px; }
    .edgeLabel { font-size: 17px; }
    .cluster-label { font-size: 20px; font-weight: 700; }
---
flowchart LR
  Source["$$\begin{array}{c}\textbf{Stored GT OBB rows}\\\\\text{finite pose and positive extent}\end{array}$$"]
  Pool["$$\begin{array}{c}\textbf{Oracle task population}\\\\e\in\mathcal{E}_{\mathrm{valid}}\end{array}$$"]
  Sample["$$\begin{array}{c}\textbf{Seeded sampling}\\\\\text{uniform without replacement}\\\\\text{manifest cap }K\end{array}$$"]
  Task["$$\begin{array}{c}\textbf{Oracle target task}\\\\e,\ \boldsymbol{\phi}_{e}\\\\\text{GT identity and geometry}\end{array}$$"]
  Labels["$$\begin{array}{c}\textbf{Oracle labels and evaluation}\\\\r_t^e,\ \mathrm{RRI}_{t,i}^{e}\\\\\text{candidate validity and lineage}\end{array}$$"]
  Future["$$\begin{array}{c}\textbf{Future observed-target route}\\\\\text{proposal, association, and support}\\\\\text{not current oracle-task admission}\end{array}$$"]

  Source -->|"geometry admission"| Pool
  Pool --> Sample
  Sample --> Task
  Task -->|"$$q_{t,i}\in\mathcal{Q}_t$$"| Labels
  Future -. "separate protocol" .-> Task

  classDef input fill:#D5E8D4,stroke:#82B366,color:#17202A,stroke-width:1.5px,rx:0,ry:0;
  classDef output fill:#F8CECC,stroke:#B85450,color:#17202A,stroke-width:1.5px,rx:0,ry:0;
  classDef compute fill:#E1D5E7,stroke:#9673A6,color:#17202A,stroke-width:1.5px,rx:8,ry:8;
  classDef data fill:#F5F5F5,stroke:#9E9E9E,color:#17202A,stroke-width:1.2px,rx:0,ry:0;

  class Source input;
  class Pool,Task data;
  class Sample compute;
  class Labels output;
  class Future compute;
