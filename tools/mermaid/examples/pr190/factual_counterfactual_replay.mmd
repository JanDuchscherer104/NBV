---
config:
  theme: base
  htmlLabels: true
  forceLegacyMathML: true
  layout: elk
  fontFamily: "CMU Serif, Latin Modern Roman, serif"
  flowchart:
    nodeSpacing: 16
    rankSpacing: 24
    padding: 12
    curve: linear
    wrappingWidth: 250
  themeVariables:
    background: "#ffffff"
    fontFamily: "CMU Serif, Latin Modern Roman, serif"
    fontSize: "24px"
    primaryTextColor: "#17202A"
    edgeLabelBackground: "#ffffff"
    clusterBkg: "#fafafa"
    clusterBorder: "#737373"
    lineColor: "#475569"
  themeCSS: |
    .nodeLabel { font-family: "CMU Serif", "Latin Modern Roman", serif; font-size: 24px; }
    .nodeLabel div { flex-direction: column; line-height: 1.2; }
    .nodeLabel b { display: block; font-size: 28px; font-weight: 700; line-height: 1.15; margin-bottom: 6px; }
    .nodeLabel code { display: block; font-family: "CMU Serif", "Latin Modern Roman", serif; font-size: 22px; line-height: 1.15; margin: 0; }
    .edgeLabel { font-family: "CMU Serif", "Latin Modern Roman", serif; font-size: 22px; }
    .cluster-label { font-family: "CMU Serif", "Latin Modern Roman", serif; font-size: 24px; font-weight: 700; }
    .katex { font-size: 1em; }
    .katex-display { margin: 0; }
---
flowchart TB
  %% aria-notation: strict
  %% aria-architecture: symbolic-computational
  %% aria-width-mm: 160
  accTitle: Oracle labels and computational replay
  accDescr: Source-bound operations show dense rendering and current S0 pose/budget/candidate transitions. Current gains are gathered only for the selected action. Double-Q uses successor support, delayed evaluation and terminal zeroing. Selected-depth fusion is a separate privileged control; unselected depth never updates actor state.
  %% aria-math: symbols.rl.s_oracle
  Oracle["<b>Oracle state</b>$$s_t^{\mathrm{oracle}}$$"]:::input
  %% aria-math: symbols.oracle.candidates_t
  Candidates["<b>Candidate table</b>$$\mathcal{Q}_t$$"]:::input
  %% aria-compute: equations.rl.target_root_gain_reward
  %% aria-math: symbols.oracle.depth_q
  Render["<b>Counterfactual labels</b><code>render → backproject</code><code>target_error → root_gain</code>$$\boldsymbol{D}_q$$"]:::compute
  %% aria-math: symbols.rl.s_pose
  State["<b>Pose-only state</b>$$s_t^{\mathrm{S0-pose}}$$"]:::data
  %% aria-compute: equations.rl.qh_masked_argmax
  Select["<b>Select one action</b><code>argmax(values[valid])</code>"]:::compute
  %% aria-compute: equations.rl.replay_transition
  %% aria-math: symbols.rl.selected_pose_prefix_next
  Step["<b>Replay step</b><code>pose ← selected_pose</code><code>append(prefix, pose)</code><code>budget ← budget - 1</code>$$\boldsymbol{H}_{t+1}^{\mathrm{pose}}$$"]:::compute
  %% aria-compute: equations.rl.replay_transition
  Next["<b>Successor candidates</b><code>Generate(next_pose,</code><code>target, seed(prefix))</code>"]:::compute
  %% aria-compute: equations.rl.target_root_gain_reward
  %% aria-math: symbols.entity.target_reward
  Reward["<b>Selected reward</b><code>gather(gains, action)</code>$$r_t^e$$"]:::compute
  %% aria-compute: equations.rl.qh_doubleq_index
  Backup["<b>Double-Q continuation</b><code>0 if terminal else</code><code>Q_target(next, h - 1,</code><code>argmax(Q_online(next,</code><code>h - 1)[supported]))</code>"]:::compute
  %% aria-math: equations.rl.qh_doubleq_target
  Target["<b>Training target</b>$$y_t^{(h,e)}=r_t^e+\gamma B_t^{(h,e)}$$"]:::compute
  %% aria-compute: equations.model.qh_s1_selected_surface
  Fusion["<b>Selected-depth encoder</b><code>backproject → transform</code><code>PointMLP → mean / max</code><code>root + residual</code>"]:::compute
  Oracle --> Render
  Candidates --> Render
  State --> Select
  Candidates --> Select
  Select --> Step --> Next --> Backup
  Render -->|"gain labels"| Reward
  Select --> Reward
  Reward --> Target
  Backup --> Target
  Render -.->|"selected depth only"| Fusion
  Select -.->|"selection gate"| Fusion
  style Fusion stroke-dasharray:5 4

  classDef input fill:#D5E8D4,stroke:#82B366,color:#17202A,stroke-width:1.5px,rx:0,ry:0;
  classDef output fill:#F8CECC,stroke:#B85450,color:#17202A,stroke-width:1.5px,rx:0,ry:0;
  classDef compute fill:#E1D5E7,stroke:#9673A6,color:#17202A,stroke-width:1.5px,rx:8,ry:8;
  classDef data fill:#F5F5F5,stroke:#9E9E9E,color:#17202A,stroke-width:1.2px,rx:0,ry:0;
  classDef status fill:#FFFFFF,stroke:#475569,color:#17202A,stroke-width:1.5px,stroke-dasharray:5 4,rx:0,ry:0;
