---
config:
  theme: base
  htmlLabels: true
  forceLegacyMathML: true
  layout: elk
  fontFamily: "CMU Serif, Latin Modern Roman, serif"
  flowchart:
    nodeSpacing: 16
    rankSpacing: 24
    padding: 12
    curve: linear
    wrappingWidth: 320
  themeVariables:
    background: "#ffffff"
    fontFamily: "CMU Serif, Latin Modern Roman, serif"
    fontSize: "24px"
    primaryTextColor: "#17202A"
    edgeLabelBackground: "#ffffff"
    clusterBkg: "#fafafa"
    clusterBorder: "#737373"
    lineColor: "#475569"
  themeCSS: |
    .nodeLabel { font-family: "CMU Serif", "Latin Modern Roman", serif; font-size: 24px; }
    .nodeLabel div { flex-direction: column; line-height: 1.2; }
    .nodeLabel b { display: block; font-size: 28px; font-weight: 700; line-height: 1.15; margin-bottom: 6px; }
    .edgeLabel { font-family: "CMU Serif", "Latin Modern Roman", serif; font-size: 22px; }
    .cluster-label { font-family: "CMU Serif", "Latin Modern Roman", serif; font-size: 24px; font-weight: 700; }
    .katex { font-size: 1em; }
    .katex-display { margin: 0; }
---
flowchart TB
  %% aria-notation: typst
  %% aria-architecture: symbolic-computational
  %% aria-width-mm: 160
  accTitle: A1 interaction and admissible selection
  accDescr: Canonical shared equations show the five state tokens, independent candidate-to-state attention, concatenation with an elementwise product, and masked selection. Ak is A1 here. Candidate encoding and the separate physical feasibility head are outside this focused view; no candidate-to-candidate attention is implied.
  Query["<b>Query</b>$$#symb.model.candidate_row$$"]:::input
  State["<b>Context</b>$$#eqs.model.qh_state_tokens$$"]:::compute
  Read["<b>A1</b>$$#eqs.model.qh_a1_read$$"]:::compute
  Fuse["<b>Fusion</b>$$#eqs.model.qh_feature_fusion$$"]:::compute
  Value["<b>Value</b>$$#symb.rl.conditional_q$$"]:::output
  Mask["<b>Support</b>$$#symb.rl.action_mask$$"]:::input
  Policy["<b>Selection</b>$$#eqs.rl.qh_masked_argmax$$"]:::compute
  Query --> Read
  State --> Read
  Query --> Fuse
  Read --> Fuse
  Fuse --> Value
  Value --> Policy
  Mask --> Policy

  classDef input fill:#D5E8D4,stroke:#82B366,color:#17202A,stroke-width:1.5px,rx:0,ry:0;
  classDef output fill:#F8CECC,stroke:#B85450,color:#17202A,stroke-width:1.5px,rx:0,ry:0;
  classDef compute fill:#E1D5E7,stroke:#9673A6,color:#17202A,stroke-width:1.5px,rx:8,ry:8;
  classDef data fill:#F5F5F5,stroke:#9E9E9E,color:#17202A,stroke-width:1.2px,rx:0,ry:0;
  classDef status fill:#FFFFFF,stroke:#475569,color:#17202A,stroke-width:1.5px,stroke-dasharray:5 4,rx:0,ry:0;
