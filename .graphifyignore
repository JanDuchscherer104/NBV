# ARIA-NBV root Graphify corpus policy.
#
# Start closed. Admit only high-signal formats handled directly by upstream
# Graphify plus the reproducible Markdown projection. Raw Typst, BibTeX,
# JSONL, TeX, and bulk PDFs stay in their exact-source owners and are exposed
# to navigation only through graphify-input/ identity pages.
*
**

# Python package code and maintained package orientation.
!aria_nbv/
!aria_nbv/**/
!aria_nbv/**/*.py
!aria_nbv/**/*.md
!aria_nbv/**/*.rst
!aria_nbv/**/*.txt
!aria_nbv/**/*.yaml
!aria_nbv/**/*.yml

# Maintained public documentation in upstream-native text formats.
!docs/
!docs/**/
!docs/**/*.md
!docs/**/*.qmd
!docs/**/*.rst
!docs/**/*.txt
!docs/**/*.yaml
!docs/**/*.yml
!docs/**/*.html

# High-signal internal references and canonical state, not runtime/history.
!.agents/
!.agents/references/
!.agents/references/**/
!.agents/references/**/*.md
!.agents/memory/
!.agents/memory/state/
!.agents/memory/state/**/
!.agents/memory/state/**/*.md

# Deterministic identities for Typst links, citations, and local source assets.
!graphify-input/
!graphify-input/**/
!graphify-input/*.md
!graphify-input/**/*.md

# Generated sites, raw scientific owners, large assets, and operator state.
docs/_build/
docs/_extensions/
docs/_inv/
docs/.quarto/
docs/_freeze/
docs/_generated/
docs/_site/
docs/site_libs/
docs/index_files/
docs/*_files/
docs/reference/
docs/search.json
docs/literature/pdf/
docs/literature/tex-src/
docs/**/.jupyter_cache/
docs/**/*_files/

graphify-out/
external/
.agent/
.agents/external/
.agents/skills/
.agents/memory/history/
.agents/memory/transcripts/
.agents/archive/
.agents/work/
.codex/
.configs/
.omx/
.git/
.claude/
.venv/
aria_nbv/.omc/
aria_nbv/.venv/
aria_nbv/scripts/
aria_nbv/tests/
scripts/

**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.pyre/
**/.tox/
**/.nox/

# Raw/non-native inputs are intentionally represented through the projection.
**/*.typ
**/*.bib
**/*.jsonl
**/*.tex
**/*.pdf

# Other bulky media and archives stay outside the navigation corpus.
**/*.7z
**/*.avi
**/*.bin
**/*.gif
**/*.gz
**/*.jpeg
**/*.jpg
**/*.mov
**/*.mp4
**/*.png
**/*.tar
**/*.tgz
**/*.webm
**/*.webp
**/*.zip
