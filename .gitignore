# OMX drafts and runtime state are local. The registry admits current planning
# evidence at native role paths and superseded evidence only in its reserved
# archive namespace; unregistered visible files fail validation.
.omx/*
!.omx/context/
.omx/context/*
!.omx/context/*.md
!.omx/specs/
.omx/specs/*
!.omx/specs/**/*.md
!.omx/plans/
