!.omx/plans/*.json
!.omx/archive/
.omx/archive/*
!.omx/archive/accepted-bundles/
.omx/archive/accepted-bundles/*
!.omx/archive/accepted-bundles/*/
!.omx/archive/accepted-bundles/*/**

