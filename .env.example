# Source from the repository root after running scripts/setup_worktree_env.sh.
# Commands run through aria_nbv_run use the shared aria-nbv mamba toolchain.
export ARIA_NBV_MAMBA_ENV=aria-nbv

aria_nbv_run() {
  mamba run -n "$ARIA_NBV_MAMBA_ENV" "$@"
}

export VIRTUAL_ENV="$PWD/aria_nbv/.venv"
export PATH="$VIRTUAL_ENV/bin:$PATH"
export PYTHONPATH="$PWD/aria_nbv:$PWD/external/efm3d${PYTHONPATH:+:$PYTHONPATH}"
# A shared venv must not be re-bound to the current worktree by uv.
export UV_NO_SYNC=1
