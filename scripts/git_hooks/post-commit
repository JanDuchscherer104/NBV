#!/bin/sh
# Synchronize Graphify after commits that change its explicit source corpus.

set -eu

REPO=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$REPO" || exit 0

status=$(
  git diff --name-status --find-renames HEAD~1 HEAD 2>/dev/null ||
    git diff-tree --root --no-commit-id --name-status -r -M HEAD 2>/dev/null ||
    true
)
changed=$(printf '%s\n' "$status" | awk -F '\t' '
  /^R[0-9]+\t|^C[0-9]+\t/ {
    print $2
    print $3
    next
  }
  NF >= 2 {
    print $2
  }
')
[ -n "$changed" ] || exit 0

PYTHON=${PYTHON_INTERPRETER:-python3}
relevant=$(printf '%s\n' "$changed" | "$PYTHON" -c 'import sys
sys.path.insert(0, "scripts")
from graphify_adapter import classify_path, load_config, selected_literature_dirs
paths = {path.strip() for path in sys.stdin if path.strip()}
implementation = {
    ".graphify.toml",
    "scripts/graphify_adapter.py",
    "scripts/graphify_bridge.py",
}
if paths & implementation:
    print("1")
    raise SystemExit
config = load_config()
selected = selected_literature_dirs()
print("1" if any(classify_path(path, config, selected) for path in paths) else "0")')
[ "$relevant" = "1" ] || exit 0

"$PYTHON" scripts/graphify_adapter.py sync
