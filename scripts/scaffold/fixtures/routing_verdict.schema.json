{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARIA-NBV routing trial verifier verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trial_id",
    "verdict",
    "evidence",
    "rubric_evaluations",
    "missing_requirements",
    "forbidden_observations",
    "tested_commit",
    "rubric_commit"
  ],
  "properties": {
    "trial_id": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["pass", "fail"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_index", "event_type", "item_type", "claim"],
        "properties": {
          "event_index": {"type": "integer", "minimum": 0},
          "event_type": {"type": "string", "minLength": 1, "maxLength": 2048},
          "item_type": {"type": "string", "minLength": 1, "maxLength": 2048},
          "claim": {"type": "string", "minLength": 1, "maxLength": 2048}
        }
      }
    },
    "rubric_evaluations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "subject",
          "status",
          "basis",
          "evidence_event_indices"
        ],
        "properties": {
          "kind": {
            "enum": [
              "expected_owner_path",
              "stable_skill_id",
              "expected_tool_ref",
              "forbidden_tool_ref",
              "required_outcome",
              "forbidden_outcome"
            ]
          },
          "subject": {"type": "string", "minLength": 1, "maxLength": 2048},
          "status": {
            "enum": ["satisfied", "not_satisfied", "not_observed", "observed"]
          },
          "basis": {"enum": ["event_evidence", "trial_response"]},
          "evidence_event_indices": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "missing_requirements": {
      "type": "array",
      "maxItems": 64,
      "items": {"type": "string", "maxLength": 2048}
    },
    "forbidden_observations": {
      "type": "array",
      "maxItems": 64,
      "items": {"type": "string", "maxLength": 2048}
    },
    "tested_commit": {"type": "string", "minLength": 1},
    "rubric_commit": {"type": "string", "minLength": 1}
  }
}
