{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARIA-NBV routing trial verifier verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trial_id",
    "verdict",
    "evidence",
    "missing_requirements",
    "forbidden_observations",
    "tested_commit",
    "rubric_commit"
  ],
  "properties": {
    "trial_id": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["pass", "fail"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["event_index", "event_type", "item_type", "claim"], "properties": {"event_index": {"type": "integer", "minimum": 0}, "event_type": {"type": "string", "minLength": 1, "maxLength": 2048}, "item_type": {"type": "string", "minLength": 1, "maxLength": 2048}, "claim": {"type": "string", "minLength": 1, "maxLength": 2048}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "sha256", "claim"], "properties": {"kind": {"const": "final_diff"}, "sha256": {"type": "string", "minLength": 64, "maxLength": 64}, "claim": {"type": "string", "minLength": 1, "maxLength": 2048}}}
      ]}
    },
    "missing_requirements": {
      "type": "array",
      "maxItems": 64,
      "items": {"type": "string", "maxLength": 2048}
    },
    "forbidden_observations": {
      "type": "array",
      "maxItems": 64,
      "items": {"type": "string", "maxLength": 2048}
    },
    "tested_commit": {"type": "string", "minLength": 1},
    "rubric_commit": {"type": "string", "minLength": 1}
  }
}
