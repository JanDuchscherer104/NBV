{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "additionalProperties":false,
  "required":["trial_id","candidate_sha256","tested_commit","rubric_commit","verdict","reason"],
  "properties":{
    "trial_id":{"type":"string","minLength":1,"maxLength":128},
    "candidate_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "tested_commit":{"type":"string","minLength":1,"maxLength":128},
    "rubric_commit":{"type":"string","minLength":1,"maxLength":128},
    "verdict":{"enum":["pass","fail"]},
    "reason":{"type":"string","minLength":1,"maxLength":1024}
  }
}
