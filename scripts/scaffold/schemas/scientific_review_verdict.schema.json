{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "additionalProperties":false,
  "required":["trial_id","candidate_sha256","outcome"],
  "properties":{
    "trial_id":{"type":"string","minLength":1,"maxLength":128},
    "candidate_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "outcome":{
      "type":"object","additionalProperties":false,"required":["clear","findings"],
      "properties":{
        "clear":{"type":"boolean"},
        "findings":{
          "type":"array","maxItems":16,
          "items":{
            "type":"object","additionalProperties":false,
            "required":["category","severity","evidence","reason","impact","action"],
            "properties":{
              "category":{"enum":["confounding","actor_oracle_leakage","invalidity_utility","claim_escalation","experimental_units","uncertainty","implementation_status"]},
              "severity":{"enum":["low","medium","high","critical"]},
              "evidence":{"type":"object","additionalProperties":false,"required":["line_start","line_end","text"],"properties":{"line_start":{"type":"integer","minimum":1},"line_end":{"type":"integer","minimum":1},"text":{"type":"string","minLength":1,"maxLength":512}}},
              "reason":{"type":"string","minLength":1,"maxLength":1024},
              "impact":{"type":"string","minLength":1,"maxLength":1024},
              "action":{"type":"string","minLength":1,"maxLength":1024}
            }
          }
        }
      }
    }
  }
}
