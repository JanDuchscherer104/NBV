{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_revision", "material_sources", "toolchain", "report_schema_version", "build_commands"],
  "properties": {
    "schema_version": {"type": "string", "const": "thesis-toolchain-lock-v1"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "material_sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "toolchain": {"type": "object", "additionalProperties": false, "required": ["compiler", "packages", "fonts", "csl", "rasterizer", "pdf_comparator"], "properties": {
      "compiler": {"type": "object", "additionalProperties": false, "required": ["command", "version", "binary_sha256"], "properties": {"command": {"type": "string"}, "version": {"type": "string"}, "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
      "packages": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["identity"], "properties": {"identity": {"type": "string"}}}},
      "fonts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["family", "source", "variants", "system_files"], "properties": {"family": {"type": "string"}, "source": {"type": "string", "enum": ["system", "embedded_in_compiler"]}, "variants": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["style", "weight", "stretch"], "properties": {"style": {"type": "string"}, "weight": {"type": "integer", "minimum": 1}, "stretch": {"type": "integer", "minimum": 1}}}}, "system_files": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["basename", "sha256"], "properties": {"basename": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}, "compiler_binding": {"type": "object", "additionalProperties": false, "required": ["version", "binary_sha256"], "properties": {"version": {"type": "string"}, "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}}},
      "csl": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
      "rasterizer": {"type": "object", "additionalProperties": false, "required": ["backend", "version", "render_script", "render_script_sha256", "ppi"], "properties": {"backend": {"type": "string"}, "version": {"type": "string"}, "render_script": {"type": "string"}, "render_script_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "ppi": {"type": "integer", "minimum": 1}}},
      "pdf_comparator": {"type": "object", "additionalProperties": false, "required": ["command", "version", "binary_sha256", "ppi"], "properties": {"command": {"type": "string"}, "version": {"type": "string"}, "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "ppi": {"type": "integer", "const": 72}}}
    }},
    "report_schema_version": {"type": "string"},
    "build_commands": {"type": "object", "additionalProperties": false, "required": ["development", "submission"], "properties": {"development": {"type": "string"}, "submission": {"type": "string"}}}
  }
}
