{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_revision", "material_sources", "toolchain", "report_schema_version", "build_commands"],
  "properties": {
    "schema_version": {"type": "string", "const": "thesis-toolchain-lock-v1"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "material_sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "toolchain": {"type": "object", "additionalProperties": false, "required": ["compiler", "packages", "fonts", "csl", "rasterizer"], "properties": {
      "compiler": {"type": "object", "additionalProperties": false, "required": ["executable", "version"], "properties": {"executable": {"type": "string"}, "version": {"type": "string"}}},
      "packages": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["identity"], "properties": {"identity": {"type": "string"}}}},
      "fonts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["family", "selected", "installed_variants"], "properties": {"family": {"type": "string"}, "selected": {"type": "string"}, "installed_variants": {"type": "array", "items": {"type": "string"}}}}},
      "csl": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
      "rasterizer": {"type": "object", "additionalProperties": false, "required": ["backend", "version", "render_script", "render_script_sha256", "ppi"], "properties": {"backend": {"type": "string"}, "version": {"type": "string"}, "render_script": {"type": "string"}, "render_script_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "ppi": {"type": "integer", "minimum": 1}}}
    }},
    "report_schema_version": {"type": "string"},
    "build_commands": {"type": "object", "additionalProperties": false, "required": ["development", "submission"], "properties": {"development": {"type": "string"}, "submission": {"type": "string"}}}
  }
}
